{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Scope: only packages/opencode is analyzed (the root "knip" script passes --workspace packages/opencode).
  // Every exclusion below is narrowed to the exact file or package Knip reported, so anything new still fails CI.
  "workspaces": {
    "packages/opencode": {
      // src/index.ts, src/node.ts, src/temporary.ts and test/preload.ts are already detected
      // from package.json scripts and bunfig.toml, so only the remaining entries are listed.
      "entry": [
        "script/**/*.{ts,mjs}",
        "test/**/*.test.{ts,tsx}",
        // Spawned or imported by file path at runtime (Bun.spawn / path.join / pathToFileURL),
        // which static analysis cannot follow. They are real entry points of child processes.
        "test/fixture/{agent-plugin,mcp-lifecycle-stdio,mcp-session-recovery,plug-worker,plugin-meta-worker}.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "script/**/*.{ts,mjs}", "test/**/*.{ts,tsx}"],
      // Baseline (genuinely unused, upstream code): stale copies of fixtures that now live in
      // packages/core/test/fixture/flock-worker.ts and packages/tui/test/fixture/tui-sdk.ts.
      "ignoreFiles": ["test/fixture/flock-worker.ts", "test/fixture/tui-sdk.ts"],
      "ignoreDependencies": [
        // False positives: used in ways Knip cannot see.
        "tree-sitter-bash", // src/tool/shell.ts: import("tree-sitter-bash/tree-sitter-bash.wasm" as string)
        "tree-sitter-powershell", // src/tool/shell.ts: same `as string` dynamic wasm import
        "@parcel/watcher", // script/build.ts reads pkg.dependencies["@parcel/watcher"] to install native builds
        "@ff-labs/fff-bun", // script/build.ts reads pkg.dependencies["@ff-labs/fff-bun"] to install native builds
        "opencode-web-ui.gen.ts", // virtual module generated by script/build.ts at build time, not a package

        // Baseline (genuinely unused here, upstream manifest): imported only by sibling workspaces
        // that already declare them (core, tui, app, ui, session-ui, console, desktop).
        "@openauthjs/openauth",
        "@opentelemetry/context-async-hooks",
        "@opentelemetry/exporter-trace-otlp-http",
        "@pierre/diffs",
        "@solid-primitives/event-bus",
        "@solid-primitives/scheduled",
        "@zip.js/zip.js",
        "glob",
        "immer",
        "minimatch",
        "opentui-spinner",
        "xdg-basedir",

        // Baseline (genuinely unused, upstream manifest): not imported anywhere in the repo.
        "@gitlab/opencode-gitlab-auth",
        "@babel/core",
        "@types/babel__core",
        "chokidar",
        "partial-json",
        "why-is-node-running",

        // Baseline: listed in both dependencies and devDependencies, so the devDependency copy is redundant.
        "@opencode-ai/script",
        "@standard-schema/spec",
        "drizzle-orm"
      ],
      // System tools invoked from shell commands, not npm packages.
      "ignoreBinaries": ["ldd", "sha256sum", "makepkg", "sqlite3"]
    }
  },
  // Baseline (genuine, upstream code): existing unused or aliased exports in specific files.
  // Only these files and issue types are skipped; new unused exports elsewhere are still reported.
  "ignoreIssues": {
    // Intentional backward-compatible aliases (e.g. `export const mapToolKind = toToolKind`).
    "packages/opencode/src/acp/tool.ts": ["duplicates"],
    // Plugin convention: exported both by name and as default.
    "packages/opencode/src/control-plane/dev/debug-workspace-plugin.ts": ["duplicates"],
    "packages/opencode/src/cli/cmd/run/{footer.prompt,footer.view,scrollback.writer}.tsx": ["exports"],
    "packages/opencode/test/cli/acp/acp-test-client.ts": ["exports"],
    "packages/opencode/test/fixture/{fixture,tui-runtime}.ts": ["exports"],
    "packages/opencode/test/lib/{cli-process,effect,llm-server,snapshot}.ts": ["exports", "types"],
    "packages/opencode/test/server/httpapi-exercise/{dsl,routing,types}.ts": ["exports", "types"]
  }
}
